APP_NAME=Concert CRM
POSTGRES_DB=concert_crm
POSTGRES_USER=concert_crm
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://concert_crm:CHANGE_ME@localhost:5433/concert_crm

