APP_NAME=Concert CRM
POSTGRES_DB=concert_crm
POSTGRES_USER=concert_crm
POSTGRES_PASSWORD=
FRONTEND_PORT=8080

# Only for a backend running directly on the host, outside Compose.
# DATABASE_URL=postgresql+psycopg://localhost:5432/concert_crm

# Local loopback HTTP. In production use APP_ENV=production and SESSION_COOKIE_SECURE=true.
APP_ENV=development
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=28800
# Seed is opt-in and uses a separate database ending in _seed or _test.
SEED_ENABLED=false
# SEED_DATABASE_URL=postgresql+psycopg://localhost:5432/concert_crm_seed
